# Copy to  .env  and fill in your key (never commit the real .env).
# Loaded by the FastAPI backend via app/config.py.

# --- Groq (default, free tier) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile   # optional; default

# --- OpenAI (paid) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local, no key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
