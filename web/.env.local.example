# Copy this file to  .env.local  and fill in your key.
# .env.local is git-ignored by Next.js — never commit real keys.

# --- Groq (default, free tier) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile   # optional; this is the default

# --- OpenAI (paid) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local, no key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# (make sure `ollama serve` is running at http://localhost:11434)
